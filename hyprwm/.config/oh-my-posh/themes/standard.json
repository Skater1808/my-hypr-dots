{
  "$schema": "https://githubusercontent.com",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "blue",
          "foreground": "white",
          "leading_diamond": "\ue0b6",
          "options": {
            "style": "mixed"
          },
          "style": "diamond",
          "template": "\ue5ff {{ .Path }}",
          "trailing_diamond": "\ue0b4",
          "type": "path"
        },
        {
          "type": "git",
          "background": "magenta",
          "foreground": "white",
          "exclude_folders": [
            "~"
          ],
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}white{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}white{{ end }}",
            "{{ if gt .Ahead 0 }}white{{ end }}",
            "{{ if gt .Behind 0 }}white{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}red{{ end }}",
            "{{ if gt .Ahead 0 }}blue{{ end }}",
            "{{ if gt .Behind 0 }}blue{{ end }}"
          ],
          "leading_diamond": " \ue0b6",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}"
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b4"
        },
        {
          "foreground": "red",
          "style": "plain",
          "template": "x ",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "green",
          "options": {
            "display_mode": "files",
            "fetch_package_manager": true,
            "bun_icon": "<parentForeground>\ue76f bun</>",
            "npm_icon": "<red>\ue616 npm</> ",
            "pnpm_icon": "<yellow>\ue865 pnpm</> ",
            "yarn_icon": "<cyan>\ue6a7 yarn</> "
          },
          "template": "{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}\ue718 {{ .Full }}"
        },
        {
          "foreground": "blue",
          "options": {
            "display_mode": "files"
          },
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "type": "crystal"
        },
        {
          "foreground": "red",
          "options": {
            "display_mode": "files"
          },
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "type": "ruby"
        },
        {
          "foreground": "yellow",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": false
          },
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "type": "python"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "green",
          "style": "plain",
          "template": "\u279c ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "green",
    "template": "\u279c "
  },
  "version": 4
}
