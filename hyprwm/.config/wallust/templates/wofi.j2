/* Wofi style.css generated by wallust from {{wallpaper}} */

@define-color background {{background}};
@define-color foreground {{foreground}};
@define-color cursor {{cursor}};

@define-color color0  {{color0 }};
@define-color color1  {{color1 }};
@define-color color2  {{color2 }};
@define-color color3  {{color3 }};
@define-color color4  {{color4 }};
@define-color color5  {{color5 }};
@define-color color6  {{color6 }};
@define-color color7  {{color7 }};
@define-color color8  {{color8 }};
@define-color color9  {{color9 }};
@define-color color10 {{color10}};
@define-color color11 {{color11}};
@define-color color12 {{color12}};
@define-color color13 {{color13}};
@define-color color14 {{color14}};
@define-color color15 {{color15}};

/* Catppuccin-like semantic aliases for wofi */
@define-color rosewater @color15;
@define-color flamingo  @color14;
@define-color pink      @color13;
@define-color mauve     @color12;
@define-color red       @color1;
@define-color maroon    @color9;
@define-color peach     @color11;
@define-color yellow    @color3;
@define-color green     @color2;
@define-color teal      @color10;
@define-color sky       @color14;
@define-color sapphire  @color12;
@define-color blue      @color4;
@define-color lavender  @color13;
@define-color text      @foreground;
@define-color subtext1  @color7;
@define-color subtext0  @color8;
@define-color overlay2  @color6;
@define-color overlay1  @color5;
@define-color overlay0  @color8;
@define-color surface2  @color0;
@define-color surface1  @color0;
@define-color surface0  @color0;
@define-color base      @background;
@define-color mantle    @background;
@define-color crust     @color0;


* {
    font-family: JetBrainsMono Nerd Font;
    font-size: 17px;
    border-radius: 15px;
}

window {
    margin: 5px;
    background-color: @mantle;
    border: 3px solid @lavender;
    border-radius: 15px;
}

#outer-box {
    margin: 4px;
    border-radius: 15px;
}

#input {
    margin: 10px;
    background-color: @base;
    color: @text;
    border-radius: 8px;
    padding: 3px;
    border: 1px solid @subtext1; 
}

#inner-box {
    margin: 0px 10px 50px 10px;
    border-radius: 0px;
    background-color: @mantle;
}

#scroll {
    margin: 0px 0px;
    border-radius: 8px;
    border: none;
}

#text {
    margin: 2px;
}

#entry {
    border: none;
    border-radius: 8px;
    transition: all 0.1s ease;
    color: @text;
}

#entry #text {
    color: @text;
}

#entry:hover {
    background-color: @surface1;
    border-left: 4px solid @lavender;
}

#entry:selected {
    color: @crust;
    background: @lavender;
    border: 2px solid @rosewater;
    box-shadow: 0 0 8px @lavender;
}

#entry:selected #text {
    color: @crust;
    font-weight: bold;
}